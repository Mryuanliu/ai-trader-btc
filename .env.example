# ============================================================
# AI Trader BTC —— 环境变量样例
# 复制为 .env 后按需修改；未配置的密钥项系统会自动降级运行
# ============================================================

# ---------- 基础 ----------
NODE_ENV=development
PORT=3001
APP_MASTER_KEY=change-me-32-bytes-master-key-please
# JWT 密钥，用于后台管理接口鉴权
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=12h
# 默认管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ai_trader
DB_PASSWORD=ai_trader_pwd
DB_DATABASE=ai_trader
# 开发环境允许 synchronize 自动建表；生产环境请设为 false 并使用 migration
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ---------- 运行模式 ----------
# dry_run = 只落库不真实发单；testnet = 发单到账户环境的测试网/模拟盘系统；live = 实盘
# 注意：testnet 模式下，实际请求打到哪个主机由账户环境（BINANCE_ENV）决定
APP_RUN_MODE=dry_run
# 实盘二次确认 token，调用实盘下单接口时需要携带

# ---------- 大模型（DeepSeek，OpenAI 兼容协议）----------
# 留空则自动降级为「纯技术指标策略」，决策记录会标记 degraded=true
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT_MS=30000

# ---------- 币安 ----------
# 账户环境：demo=模拟盘 / testnet=测试网 / live=实盘
#   模拟盘（Demo Mode，官方推荐）申请地址：https://demo.binance.com/en/my/settings/api-management
#   旧测试网申请地址：https://testnet.binance.vision
# 三者的路径、鉴权头与签名规则完全一致，仅主机域名不同：
#   demo    -> https://demo-api.binance.com    (WS: wss://demo-stream.binance.com)
#   testnet -> https://testnet.binance.vision
#   live    -> https://api.binance.com
BINANCE_ENABLED=false
BINANCE_ENV=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 旧开关，仅在 BINANCE_ENV 未设置时生效
BINANCE_TESTNET=true

# ---------- 币安 U 本位合约 ----------
# 不填 API_KEY/SECRET 时自动复用上面的币安现货密钥（demo 环境同一 key 通用，
# 前提是 demo 门户勾选了「启用未来(合约)」权限）
#   合约 demo = 合约 testnet，是同一个环境
#   demo    -> https://demo-fapi.binance.com  (WS: wss://demo-fstream.binance.com)
#   live    -> https://fapi.binance.com
BINANCE_FUTURES_ENABLED=false
BINANCE_FUTURES_ENV=demo
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# ---------- 欧意 OKX ----------
# Demo 盘: https://www.okx.com/account/my-api (需勾选 Demo trading)
OKX_ENABLED=false
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true

# ---------- 新闻源（免费 RSS，无需 Key）----------
NEWS_ENABLED=true
NEWS_FETCH_INTERVAL_SEC=900
NEWS_SOURCES=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://bitcoinmagazine.com/feed

# ---------- 网络代理（REST 与 WebSocket 同时生效）----------
# 访问境外交易所受阻时填写，留空则直连。
# 例：本机 Clash Verge 的混合代理端口为 7897
#   HTTPS_PROXY=http://127.0.0.1:7897
#   NO_PROXY=localhost,127.0.0.1
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1

# ---------- CORS / 前端 ----------
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# ---------- 飞书推送（自建应用 + SDK，用于订单成交/结束通知）----------
# 三项留空则推送整体关闭（no-op）。ENABLED=false 可临时静音。
# 接入步骤：
#   1) 飞书开放平台建「企业自建应用」，拿到 App ID / App Secret；
#   2) 开通 im:message（发消息）权限并发布版本；
#   3) 把应用机器人拉进目标群，取该群 chat_id（可经 im.v1.chat.list 或事件日志获取）。
FEISHU_PUSH_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# ---------- 飞书对话机器人（长连接收消息 + LLM 工具循环）----------
# 开启前置步骤（飞书开放平台）：
#   1) 同一自建应用开启「事件订阅 → 长连接模式」，订阅 im.message.receive_v1；
#   2) 权限追加：im:message.group_at_msg（接收群 @消息）；发布版本后生效；
#   3) 把应用机器人拉进目标群（与推送共用 chat）。
# 长连为单实例互斥：同一 APP_ID 多处启动会互抢事件，生产只跑一份。
FEISHU_BOT_ENABLED=false
# 白名单群（逗号分隔 chat_id）；留空 = 只响应 FEISHU_CHAT_ID
FEISHU_BOT_ALLOWED_CHATS=
# 可选（长连接模式一般留空）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ---------- 通用对话 LLM（飞书机器人/Web 聊天复用，与 analyzeContext 分离）----------
LLM_CHAT_MODEL=deepseek-chat
LLM_CHAT_TIMEOUT_MS=45000
LLM_MAX_TOOL_ROUNDS=6

# ---------- MCP / Agent Skills（均为只加能力，不碰交易主链路）----------
# JSON 数组：[{"name":"x","transport":"http","url":"https://.../mcp"}]
#         或 {"name":"y","transport":"stdio","command":"node","args":["server.js"]}
# 留空不启用；MCP 工具默认按写操作对待，全部走确认流。
MCP_SERVERS=
# 技能目录（agent/skills/<name>/SKILL.md，对齐 agentskills.io 开放标准）；留空自动探测
SKILLS_DIR=
